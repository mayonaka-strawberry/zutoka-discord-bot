# UTF-8 everywhere: re-saving as Windows ANSI turns Japanese text into mojibake that is
# still valid UTF-8. tests/test_source_encoding.py catches it.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
